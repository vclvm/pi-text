# The agent's image: Debian, Pi and a development toolchain. Every image name comes from config.yaml
# (pibox setup puts your registry in front of them).
ARG BASE_IMAGE=debian:bookworm-slim
ARG NODE_IMAGE=node:24-bookworm-slim
ARG JDK17_IMAGE=eclipse-temurin:17-jdk
ARG JDK21_IMAGE=eclipse-temurin:21-jdk
ARG JDK25_IMAGE=eclipse-temurin:25-jdk
ARG MAVEN_IMAGE=maven:3-eclipse-temurin-21
ARG GRADLE_IMAGE=gradle:jdk21
ARG DOCKER_CLI_IMAGE=docker:29-cli
FROM ${JDK17_IMAGE} AS jdk17
FROM ${JDK21_IMAGE} AS jdk21
FROM ${JDK25_IMAGE} AS jdk25
FROM ${MAVEN_IMAGE} AS maven
FROM ${GRADLE_IMAGE} AS gradle
FROM ${DOCKER_CLI_IMAGE} AS dockercli
FROM ${NODE_IMAGE} AS node

FROM ${BASE_IMAGE}
ARG UID=501
ARG GID=20
ARG PI_PACKAGE=@earendil-works/pi-coding-agent
ARG PI_APT_PACKAGES="bash ca-certificates curl git ripgrep fd-find jq httpie unzip zip less procps build-essential python3 python3-dev python3-venv python3-pip"
ARG JAVA_DEFAULT=21

# Your company's CA certificates (network.ca_certs; pibox setup puts them into generated/ca):
# trusted by the system (git, curl, apt, Python, pip), by Node (npm) and, below, by every JDK.
COPY generated/ca/ /usr/local/share/ca-certificates/pibox/
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# The steps are ordered from what changes least to what changes most: a new system package
# (pi.apt_packages) rebuilds only the apt step and the ones after it, not the JDK copies.

# Java 17/21/25, Maven, Gradle and the Docker CLI with the compose and buildx plugins, copied
# from their official images.
COPY --from=jdk17 /opt/java/openjdk /opt/jdk/17
COPY --from=jdk21 /opt/java/openjdk /opt/jdk/21
COPY --from=jdk25 /opt/java/openjdk /opt/jdk/25
COPY --from=maven /usr/share/maven /opt/maven
COPY --from=gradle /opt/gradle /opt/gradle
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
# The CA certificates in each JDK's trust store (Maven, Gradle, every Java program)
RUN set -eu; for j in /opt/jdk/*; do for c in /usr/local/share/ca-certificates/pibox/*.crt; do \
      [ -e "$c" ] || continue; \
      "$j/bin/keytool" -importcert -noprompt -cacerts -storepass changeit -alias "pibox-${c##*/}" -file "$c" >/dev/null 2>&1 || true; \
    done; done
# `jdk 17 mvn test` runs one command with another JDK.
RUN printf '#!/bin/sh\n[ -d "/opt/jdk/$1" ] || { echo "jdk: available: $(ls /opt/jdk)" >&2; exit 2; }\nexport JAVA_HOME="/opt/jdk/$1" PATH="/opt/jdk/$1/bin:$PATH"; shift; exec "$@"\n' \
      > /usr/local/bin/jdk && chmod +x /usr/local/bin/jdk
ENV JAVA_HOME=/opt/jdk/${JAVA_DEFAULT} JAVA_HOME_17=/opt/jdk/17 JAVA_HOME_21=/opt/jdk/21 JAVA_HOME_25=/opt/jdk/25 \
    MAVEN_HOME=/opt/maven GRADLE_HOME=/opt/gradle \
    PATH=/opt/jdk/${JAVA_DEFAULT}/bin:/opt/maven/bin:/opt/gradle/bin:$PATH

# Node.js (node, npm, corepack) from the official image: its binaries run on the base as they are.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node /usr/local/include/node /usr/local/include/node
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
 && node --version && npm --version

# System packages: from your repository's Debian (or Ubuntu) remotes if repository.apt_sources is set (pibox
# setup writes generated/apt/). Mounted for this step only: the login doesn't stay in the image.
# Downloaded .debs stay in BuildKit's cache (/var/cache/apt) between builds: adding a package
# downloads only that one. The base image's docker-clean would delete them after each install.
RUN --mount=type=bind,source=generated/apt,target=/pibox-apt \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    set -eu; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-downloads; \
    if [ -s /pibox-apt/debian.sources ]; then \
      . /etc/os-release; \
      if [ "$VERSION_CODENAME" != "$(cat /pibox-apt/codename)" ]; then \
        echo "pibox: the base image is Debian $VERSION_CODENAME, pibox setup asked your remotes for $(cat /pibox-apt/codename)"; exit 1; fi; \
      rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*; \
      key=/usr/share/keyrings/ubuntu-archive-keyring.gpg; [ -f "$key" ] || key=/usr/share/keyrings/debian-archive-keyring.gpg; \
      sed "s#@KEYRING@#$key#" /pibox-apt/debian.sources > /etc/apt/sources.list.d/pibox.sources; \
      mkdir -p /etc/apt/auth.conf.d; install -m 600 /pibox-apt/auth.conf /etc/apt/auth.conf.d/pibox.conf; \
    fi; \
    # No -security remote: your remotes' versions win, also over the base image's newer ones.
    up=""; if [ -e /pibox-apt/no-security ]; then \
      printf 'Package: *\nPin: release o=Debian\nPin-Priority: 1001\n\nPackage: *\nPin: release o=Ubuntu\nPin-Priority: 1001\n' > /etc/apt/preferences.d/pibox; \
      up=1; fi; \
    # The base image may not have ca-certificates yet: apt trusts your CA for an https:// mirror.
    opt=""; if ls /usr/local/share/ca-certificates/pibox/*.crt >/dev/null 2>&1; then \
      cat /usr/local/share/ca-certificates/pibox/*.crt > /tmp/pibox-ca.pem; opt="-o Acquire::https::CaInfo=/tmp/pibox-ca.pem"; fi; \
    { apt-get $opt update --error-on=any 2>&1; echo $? > /tmp/apt-update.rc; } | tee /tmp/apt-update.log; \
    [ "$(cat /tmp/apt-update.rc)" = 0 ] || exit 1; \
    # update succeeds although a source has nothing for this architecture or component: say so
    if ! ls /var/lib/apt/lists/*Packages* >/dev/null 2>&1; then \
      echo "pibox: apt-get update got no package lists for architecture $(dpkg --print-architecture) from:"; \
      grep -hE '^(URIs|Suites|Components):' /etc/apt/sources.list.d/*.sources 2>/dev/null || cat /etc/apt/sources.list; \
      echo "apt said:"; grep -E '^(Err|Ign|W|N|E):' /tmp/apt-update.log || true; exit 1; \
    fi; \
    if [ -n "$up" ]; then apt-get $opt -y --allow-downgrades dist-upgrade; fi; \
    apt-get $opt install -y --allow-downgrades --no-install-recommends $PI_APT_PACKAGES; \
    rm -f /etc/apt/preferences.d/pibox; \
    rm -f /tmp/pibox-ca.pem /tmp/apt-update.log /tmp/apt-update.rc /etc/apt/auth.conf.d/pibox.conf; \
    rm -rf /var/lib/apt/lists/*; \
    update-ca-certificates

# Pi itself, from your npm registry; corepack provides pnpm and yarn.
# Your .npmrc (registries, tokens), if pibox setup put one into generated/build/: mounted for this
# step only, so the token doesn't stay in the image.
RUN --mount=type=bind,source=generated/build,target=/pibox-build \
    --mount=type=cache,target=/root/.npm \
    if [ -f /pibox-build/npmrc ]; then export NPM_CONFIG_USERCONFIG=/pibox-build/npmrc; fi; \
    npm install -g --ignore-scripts "$PI_PACKAGE" && corepack enable

# Same UID/GID as the Mac user, so files written to the bind mounts belong to you. The cache
# folders exist in the image so that the volumes mounted on them belong to that user too.
RUN userdel -r ubuntu 2>/dev/null; userdel -r node 2>/dev/null; groupdel ubuntu 2>/dev/null; groupdel node 2>/dev/null; \
    (getent group "$GID" || groupadd -g "$GID" pi) \
 && useradd -m -o -u "$UID" -g "$GID" -s /bin/bash pi \
 && mkdir -p /home/pi/.pi/agent/sessions /home/pi/.m2 /home/pi/.gradle /home/pi/.npm /home/pi/.cache /home/pi/.docker \
 && chown -R "$UID:$GID" /home/pi
USER pi
RUN git config --global --add safe.directory '*'
ENV HOME=/home/pi PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0
ENTRYPOINT ["pi"]
