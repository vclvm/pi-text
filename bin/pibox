#!/bin/zsh
# pibox: installs, configures and runs pi-sandbox, the isolated setup for the Pi coding agent
# (docs/pi-setup.md). All settings live in ~/.pi-sandbox/config.yaml.
#   pibox help      lists the commands
setopt err_exit no_unset pipe_fail

SELF="${0:A}"                               # this script; $0 means the function name inside functions
SB="${PI_SANDBOX_DIR:-$HOME/.pi-sandbox}"; SB="${SB:A}"
CONFIG="$SB/config.yaml"
SYSBOX_VERSION=0.7.1                        # the sysbox release pibox builds (agent_docker.mode: sysbox)
MAC_FROM_VM=192.168.5.2                     # the Mac, seen from Colima's VM (host.lima.internal)
die()  { print -u2 "pibox: $*"; exit 1 }
warn() { print -u2 "pibox: warning: $*" }
have() { (( $+commands[$1] )) }

usage() {
  print "pibox <command>      (settings: $CONFIG)

Install and configure:
  init           install or update ~/.pi-sandbox from the repository; creates config.yaml, or
                 rebuilds it from the newest template keeping the values you changed
  check          check the prerequisites and config.yaml
  setup          (re)generate every configuration from config.yaml
  config         show the settings in effect (secrets masked)

Run:
  up             start the VM, build the images, start bridge, proxy and the agent's Docker engine
  run [args]     Pi in a fresh container, in the current folder (args go to pi)
  approve        the approval console for the agent's web requests (detach: Ctrl-P Ctrl-Q)
  log            follow the web journal
  shell          a bash shell in the agent's container, without Pi
  status         the VM and the containers
  down [--vm]    stop the containers (--vm: the Colima VM too)

Check:
  verify         try everything the agent must not be able to do
  review         git hooks, risky git config, recent .obsidian changes in your folders"
}

# ---------------------------------------------------------------- init (runs from the repository)
# Copies the components into ~/.pi-sandbox. The agent can write to your projects, so the files that
# hold the key and define the guard rails are copies outside its reach, never the repository itself.
COMPONENTS=(compose.yaml Dockerfile.pi addons extensions agent/settings.json sysbox)
BRIDGE_FILES=(Dockerfile proxy.py requirements.txt pi-trace.py)

cmd_init() {
  local src="${SELF:h:h}" f
  [[ -d "$src/sandbox" && -d "$src/bridge" ]] || src="$(cat "$SB/.source" 2>/dev/null || true)"
  [[ -n "$src" && -d "$src/sandbox" && -d "$src/bridge" ]] ||
    die "run init from the repository: <path-to-pi-text>/bin/pibox init"
  [[ "$SB/" != "$src"/* && "$src/" != "$SB"/* ]] || die "$SB and the repository $src must not contain each other"
  have yq || die "yq not found: brew install yq (pibox check lists everything that is needed)"
  # Run the repository's pibox, not this (maybe older, installed) copy: the new template must be
  # merged and checked by the rules that come with it.
  if [[ "$SELF" != "${src:A}/bin/pibox" && -z "${PIBOX_INIT_FROM_SOURCE:-}" ]]; then
    PIBOX_INIT_FROM_SOURCE=1 exec zsh "$src/bin/pibox" init
  fi

  mkdir -p "$SB"/{bin,bridge,agent,generated}; chmod 700 "$SB"
  for f in $COMPONENTS; do
    rm -rf "$SB/$f"; mkdir -p "$SB/${f:h}"; cp -R "$src/sandbox/$f" "$SB/$f"
  done
  for f in $BRIDGE_FILES; do cp "$src/bridge/$f" "$SB/bridge/$f"; done
  cp "$src/bin/pibox" "$SB/bin/.pibox.new"; chmod 755 "$SB/bin/.pibox.new"
  mv -f "$SB/bin/.pibox.new" "$SB/bin/pibox"       # a new file: a running pibox keeps reading the old one
  print -r -- "$src" > "$SB/.source"
  print "installed the components from $src into $SB"

  local existed=0; [[ -e "$CONFIG" ]] && existed=1
  update_config "$src/sandbox/config.yaml"
  if (( existed )); then                    # the values themselves; placeholders and folders: pibox check
    ( load_config ) >/dev/null && print "the settings in $CONFIG are valid" ||
      print -u2 "pibox: fix the settings above in $CONFIG, then run pibox setup"
  fi

  mkdir -p "$HOME/.local/bin"; ln -sfn "$SB/bin/pibox" "$HOME/.local/bin/pibox"
  [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] ||
    print "add ~/.local/bin to PATH, e.g. in ~/.zprofile: export PATH=\"\$HOME/.local/bin:\$PATH\""
  ok() { : }; miss() { warn "$*" }            # init only reports problems; pibox check lists everything
  docker_tools
}

# config.yaml is rebuilt from the newest template on every init, so new settings and their explanations
# appear in it. A value of yours is carried over if it differs from the default you were given: the
# value in the template your config.yaml was made from (saved as .config-template.yaml), or, if that
# isn't known, the new template. A default you never changed follows the new template.
TEMPLATE_COPY=.config-template.yaml
# yq: one line per setting, '<path as JSON>\t<value as JSON>'; models is one setting (the whole list)
YQ_LEAVES='... comments="" | (.. | select(tag == "!!null")) |= ""
  | .. | select(((path | length) == 2 and (path | .[0]) != "models") or ((path | length) == 1 and (path | .[0]) == "models"))
  | (path | to_json(0)) + "\t" + ((select(tag == "!!map" or tag == "!!seq") | to_json(0)) // (tostring | to_json(0)))'

leaves() {                                  # leaves <file> <assoc name>: the settings of a config file
  local line; set -A $2                     # the caller declares it: local -A NAME
  for line in ${(f)"$(yq "$YQ_LEAVES" "$1")"}; do
    eval "$2[\${line%%\$'\t'*}]=\${line#*\$'\t'}"
  done
}

update_config() {                           # update_config <template>
  local tpl=$1 old="$SB/$TEMPLATE_COPY" p name base tmp
  local -a kept changed added dropped T
  local -A U O N
  T=("${(@f)$(<"$tpl")}")
  if [[ -e "$CONFIG" ]]; then
    local err; err=$(yq '.' "$CONFIG" 2>&1 >/dev/null) ||
      die "$CONFIG is not valid YAML, nothing was changed: ${err#Error: }"$'\n'"Fix it, then run pibox init again"
    [[ -f "$old" ]] || old="$tpl"
    migrate
    leaves "$MERGE_SRC" U; leaves "$old" O; leaves "$tpl" N
    for p in ${(ok)U}; do
      name="${${${p:1:-1}//\"/}//,/.}"                 # ["network","bridge_port"] -> network.bridge_port
      if [[ -z "${N[$p]+x}" && "$p" != '["bridge",'* ]]; then
        dropped+=("$name: ${U[$p]}"); continue
      fi
      base="${O[$p]-${N[$p]-}}"
      if [[ -n "${O[$p]+x}" && "${U[$p]}" == "$base" ]]; then  # a default you never changed
        [[ "${N[$p]-}" == "$base" ]] || changed+=("$name: ${N[$p]-}")
        continue
      fi
      [[ "${U[$p]}" == "${N[$p]-}" ]] && continue
      kept+=("$name"); put_value ${(s:.:)name}
    done
    for p in ${(ok)N}; do                    # settings of the new template that config.yaml doesn't have
      [[ -n "${U[$p]+x}" ]] && continue
      name="${${${p:1:-1}//\"/}//,/.}"
      if [[ "$p" == '["bridge",'* && -n "${O[$p]+x}" && "$old" != "$tpl" ]]; then
        del_value ${(s:.:)name}              # a bridge variable you removed stays removed
      else
        added+=("$name")
      fi
    done
  fi
  rm -f "$SB/.config.migrated.yaml"
  tmp="$SB/.config.yaml.new"
  (umask 077; print -rl -- "${T[@]}" > "$tmp")
  yq '.' "$tmp" >/dev/null || { rm -f "$tmp"; die "merging $CONFIG with the template failed: $CONFIG is unchanged" }
  cp "$tpl" "$SB/$TEMPLATE_COPY"
  if [[ ! -e "$CONFIG" ]]; then
    mv "$tmp" "$CONFIG"
    print "created $CONFIG: fill it in, then run pibox check and pibox setup"
    return
  fi
  if cmp -s "$tmp" "$CONFIG"; then
    rm -f "$tmp"; print "$CONFIG is up to date with the template"; return
  fi
  cp -p "$CONFIG" "$CONFIG.bak"; mv "$tmp" "$CONFIG"
  print "rebuilt $CONFIG from the new template (previous file: $CONFIG.bak; your own comments are only there)"
  (( $#kept ))    && print -rl -- "  your values, kept:" "${(@)kept/#/    }"
  (( $#changed )) && print -rl -- "  defaults you never changed, now the template's new ones:" "${(@)changed/#/    }"
  (( $#added ))   && print -rl -- "  new settings, at their defaults:" "${(@)added/#/    }"
  (( $#dropped )) && print -rl -- "  settings that no longer exist, removed (they are still in config.yaml.bak):" "${(@)dropped/#/    }"
  print "  next: look through config.yaml, then pibox setup"
  return 0
}

migrate() {                                 # renamed settings: MERGE_SRC = config.yaml in today's terms
  MERGE_SRC="$CONFIG"
  [[ "$(yq '.network | has("upstream_proxy")' "$CONFIG")" == true ]] || return 0
  local up port='""'; local -a match; up=$(yq '.network.upstream_proxy // ""' "$CONFIG")
  if [[ "$up" =~ '^(https?://)?([^@/]*@)?(192\.168\.5\.2|host\.lima\.internal|127\.0\.0\.1|localhost):([0-9]+)/?$' ]]; then
    port=$match[4]; print "network.upstream_proxy $up is now network.mac_proxy_port: $port"
  elif [[ -n "$up" ]]; then
    warn "network.upstream_proxy $up is not a proxy on this Mac; only network.mac_proxy_port exists now"
  fi
  MERGE_SRC="$SB/.config.migrated.yaml"
  (umask 077; P="$port" yq '.network.mac_proxy_port = env(P) | del(.network.upstream_proxy)' "$CONFIG" > "$MERGE_SRC")
}

# Line editing of the template (array T), so its layout and comments stay as they are.
# find_key <section> [key]: REPLY = line of "section:" or of "  key:", 0 if absent;
# END = its last line (continuation lines of a multi-line value), SEC_END = the section's last value line.
find_key() {
  setopt local_options extended_glob
  local sec=$1 key=${2:-} i n=$#T top=0
  REPLY=0 END=0 SEC_END=0
  for (( i = 1; i <= n; i++ )); do [[ "$T[i]" == "$sec:"(| *) ]] && { top=$i; break }; done
  (( top )) || return 0
  SEC_END=$top
  for (( i = top + 1; i <= n; i++ )); do
    [[ "$T[i]" == [^\ \#]* ]] && break                          # the next section
    [[ "$T[i]" == \ ##[^\ \#]* ]] && SEC_END=$i                   # a value line (not blank, not a comment)
  done
  if [[ -z "$key" ]]; then
    REPLY=$top; END=$top
    for (( i = top + 1; i <= n; i++ )); do [[ "$T[i]" == \ ##[^\ \#]* ]] && END=$i || break; done
    return 0
  fi
  for (( i = top + 1; i <= SEC_END; i++ )); do
    [[ "$T[i]" == "  $key:"(| *) ]] || continue
    REPLY=$i; END=$i
    while (( END < n )) && [[ "$T[END+1]" == "   "*[^\ ]* && "$T[END+1]" != \ ##\#* ]]; do (( END++ )); done
    return 0
  done
}

render() {                                  # render <section> [key]: your value, as YAML lines for the template
  local e=".[\"$1\"]"; [[ -n "${2:-}" ]] && e="${e}[\"$2\"]"
  if [[ -n "${2:-}" ]]; then                # one line: maps and lists in flow style {…} […]
    U="$MERGE_SRC" yq -n "(load(strenv(U)) | ... comments=\"\") as \$u | {\"v\": \$u$e}
      | (.v | select(tag == \"!!map\" or tag == \"!!seq\")) |= (... style=\"flow\")" | sed '1s/^v: //'
  else                                      # a whole section's value (models): block style
    U="$MERGE_SRC" yq -n "(load(strenv(U)) | ... comments=\"\") as \$u | {\"v\": \$u$e}" | sed 1d
  fi
}

put_value() {                               # put_value <section> [key]: your value into T
  local sec=$1 key=${2:-} val line comment col
  local -a match
  local -a block
  find_key $sec $key
  if [[ -z "$key" ]]; then                  # models: the lines after "models:" up to the first comment
    block=("${(@f)$(render $sec)}")
    (( REPLY )) || { T+=("" "$sec:"); REPLY=$#T END=$#T }
    T[REPLY+1,END]=("${block[@]}"); return
  fi
  val=$(render $sec $key)
  if (( REPLY )); then
    line=$T[REPLY]
    if [[ "$line" =~ '^(  [^ #][^#]*[^ ])( +)(# .*)$' && "$match[1]" != *[\"\']* ]]; then   # keep the template's comment
      col=$(( ${#match[1]} + ${#match[2]} )) comment=$match[3]
      line="  $key: $val"; (( ${#line} < col )) && line="${(r:col:)line}" || line="$line "
      T[REPLY,END]=("$line$comment")
    else
      T[REPLY,END]=("  $key: $val")
    fi
  elif (( SEC_END )); then                  # a key the template doesn't have (bridge): end of the section
    T[SEC_END+1,SEC_END]=("  $key: $val")
  else
    T+=("" "$sec:" "  $key: $val")
  fi
}

del_value() {                               # del_value <section> <key>: remove the key and its comment
  setopt local_options extended_glob
  local i
  find_key $1 $2; (( REPLY )) || return 0
  i=$REPLY; while (( i > 1 )) && [[ "$T[i-1]" == \ ##\#* ]]; do (( i-- )); done
  T[i,END]=()
}

# The docker CLI and its plugins compose and buildx. Homebrew installs the plugins into its own
# folder, which docker only searches if ~/.docker/config.json lists it in cliPluginsExtraDirs: that
# is added here (once, with a backup). Reports through ok/miss (defined by the caller).
docker_tools() {
  local prefix="" dir="" cfg="${DOCKER_CONFIG:-$HOME/.docker}/config.json" p out link
  have brew && prefix=$(brew --prefix 2>/dev/null) && dir="$prefix/lib/docker/cli-plugins"
  if ! have docker; then
    if [[ -n "$prefix" && -x "$prefix/opt/docker/bin/docker" ]]; then
      miss "docker: installed by Homebrew but not linked: brew link docker (if brew names files of another Docker, e.g. Docker Desktop: brew link --overwrite docker)"
    else
      miss "docker: brew install docker"
    fi
    return 0
  fi
  ok "docker $(docker version --format '{{.Client.Version}}' 2>/dev/null) ($(whence -p docker))"
  for link in "${cfg:h}"/cli-plugins/docker-*(N-@); do     # links to a removed Docker Desktop shadow Homebrew's
    miss "$link points to a file that no longer exists (a removed Docker Desktop?): rm '$link'"
  done
  for p in compose buildx; do
    docker $p version >/dev/null 2>&1 && { ok "docker $p"; continue }
    if [[ -n "$dir" && -x "$dir/docker-$p" ]]; then
      plugin_dir "$dir" "$cfg"
      if docker $p version >/dev/null 2>&1; then ok "docker $p"; continue; fi
      out=$(docker $p version 2>&1 | head -2)
      miss "docker $p: $dir/docker-$p is installed and listed in $cfg, but docker can't run it: ${out//$'\n'/ }"
    else
      miss "docker $p: brew install docker-$p"
    fi
  done
}

plugin_dir() {                              # plugin_dir <dir> <config.json>: add dir to cliPluginsExtraDirs
  local dir=$1 cfg=$2
  [[ -s "$cfg" ]] && DIR="$dir" yq -p json -e '(.cliPluginsExtraDirs // []) | any_c(. == strenv(DIR))' "$cfg" >/dev/null 2>&1 && return 0
  mkdir -p "${cfg:h}"; [[ -s "$cfg" ]] || print '{}' > "$cfg"
  yq -p json '.' "$cfg" >/dev/null 2>&1 || { miss "$cfg is not valid JSON: fix it, then pibox check"; return 0 }
  [[ -e "$cfg.pibox-backup" ]] || cp -p "$cfg" "$cfg.pibox-backup"
  DIR="$dir" yq -i -p json -o json '.cliPluginsExtraDirs = ((.cliPluginsExtraDirs // []) + [strenv(DIR)] | unique)' "$cfg"
  print "  fixed    added $dir to cliPluginsExtraDirs in $cfg (backup: $cfg.pibox-backup)"
}

# ---------------------------------------------------------------- check
cmd_check() {
  local bad=0 t
  ok()   { print "  ok       $*" }
  miss() { print "  MISSING  $*"; bad=1 }
  print "Prerequisites:"
  [[ "$(uname -s)" == Darwin ]] && ok "macOS $(sw_vers -productVersion 2>/dev/null)" || print "  note     not macOS: the Colima commands won't work here"
  [[ "$(uname -m)" == arm64 ]] && ok "Apple Silicon" || print "  note     $(uname -m): Colima's vz needs Apple Silicon or a recent Intel Mac"
  have brew && ok "Homebrew" || miss "Homebrew: https://brew.sh (or your company's installation)"
  for t in colima yq git; do
    have $t && ok "$t" || miss "$t: brew install $t"
  done
  docker_tools
  [[ -x "$SB/bin/pibox" && -f "$SB/compose.yaml" ]] && ok "components in $SB" || miss "components: <path-to-pi-text>/bin/pibox init"
  print "Configuration:"
  if [[ ! -r "$CONFIG" ]]; then
    miss "$CONFIG: pibox init creates it"
  else
    ( load_config && check_config ) && ok "$CONFIG" || bad=1
  fi
  return $bad
}

check_config() {                            # values that are certainly wrong; warnings for risky ones
  local f k l; CFG_ERRORS=()
  for l in ${(f)"$(grep -nE 'YOUR_KEY|YOUR_MODEL_ID|/Users/you/' "$CONFIG" | grep -vE '^[0-9]+:[[:space:]]*#')"}; do
    CFG_ERRORS+=("${CONFIG:t}:${l%%:*}: still the template's placeholder: ${${l#*:}##[[:space:]]#}")
  done
  for k in folders.projects folders.vault; do
    f=${(P)SETTING[$k]}; [[ -d "$f" ]] || bad $k "the folder $f doesn't exist"
  done
  [[ "$SB/" != "$PROJECTS"/* ]] || bad folders.projects "must not contain $SB (the agent could change its own sandbox)"
  [[ "$SB/" != "$VAULT"/* ]] || bad folders.vault "must not contain $SB (the agent could change its own sandbox)"
  if [[ "$AGENT_DOCKER" == sysbox && "$SYSBOX_DEB_URL" == /* && ! -r "$SYSBOX_DEB_URL" ]]; then
    bad agent_docker.sysbox_deb_url "the file $SYSBOX_DEB_URL doesn't exist"
  elif [[ "$AGENT_DOCKER" == sysbox && "$SYSBOX_DEB_URL" == http* ]] && have curl && ! sysbox_installed; then
    curl -fsIL -m 20 ${MAC_PROXY_PORT:+-x http://127.0.0.1:$MAC_PROXY_PORT} --noproxy "${UPSTREAM_NO_PROXY:-}" \
        -o /dev/null "$SYSBOX_DEB_URL" 2>/dev/null ||
      bad agent_docker.sysbox_deb_url "$SYSBOX_DEB_URL can't be downloaded${MAC_PROXY_PORT:+ through the proxy on this Mac (port $MAC_PROXY_PORT)}; leave it empty to build sysbox from its sources"
  fi
  for k in repository.maven_settings repository.npmrc repository.docker_daemon repository.pip_conf repository.docker_config; do
    f=${(P)SETTING[$k]}; [[ -z "$f" || -r "$f" ]] || bad $k "the file $f doesn't exist or isn't readable"
  done
  if (( $#CFG_ERRORS )); then
    print -rl -- "${CFG_ERRORS[@]}" | sort -t: -k2,2n >&2
    die "${#CFG_ERRORS} problem(s) in $CONFIG"
  fi
  for f in "$PROJECTS" "$VAULT"; do
    [[ "$f/" != "$HOME"/(Documents|Desktop)/* ]] || warn "$f is TCC-protected; mounts are more predictable elsewhere (§6.1)"
  done
  if [[ -n "$MAC_PROXY_PORT" && "$(uname -s)" == Darwin ]]; then
    ( zmodload zsh/net/tcp && ztcp 127.0.0.1 "$MAC_PROXY_PORT" && ztcp -c "$REPLY" ) 2>/dev/null ||
      warn "nothing listens on port $MAC_PROXY_PORT of this Mac (network.mac_proxy_port): start your proxy"
  fi
  local src="$(cat "$SB/.source" 2>/dev/null || true)"
  [[ -z "$src" || ( "$src/" != "$PROJECTS"/* && "$src/" != "$VAULT"/* ) ]] ||
    warn "the repository $src is inside the agent's folders: the agent could change it. Check git status before the next pibox init"
  return 0
}

# ---------------------------------------------------------------- settings
# Every key of config.yaml (except bridge and models) and the variable that this script,
# compose.yaml and the extensions use for it.
typeset -A SETTING=(
  folders.projects PROJECTS_DIR                  folders.vault VAULT_DIR
  network.bridge_port BRIDGE_PORT                network.proxy_port PROXY_PORT
  network.mac_proxy_port MAC_PROXY_PORT          network.upstream_no_proxy UPSTREAM_NO_PROXY
  network.sandbox_subnet SANDBOX_SUBNET
  egress.allow_private EGRESS_ALLOW_PRIVATE      egress.no_approval EGRESS_NO_APPROVAL
  egress.allow_only EGRESS_ALLOW_ONLY            egress.deny EGRESS_DENY
  egress.ports EGRESS_PORTS
  extensions.bash_approval PI_BASH_APPROVAL      extensions.web_plain_http PI_WEB_PLAIN_HTTP
  extensions.searxng WEB_SEARCH_SEARXNG          extensions.fetch_max_chars WEB_FETCH_MAX_CHARS
  repository.apt_debian APT_DEBIAN               repository.apt_security APT_SECURITY
  repository.maven_settings MAVEN_SETTINGS_FILE  repository.npmrc NPMRC_FILE
  repository.docker_daemon DOCKER_DAEMON_FILE    repository.pip_conf PIP_CONF_FILE
  repository.docker_config DOCKER_CONFIG_FILE
  images.node NODE_IMAGE                         images.python PYTHON_IMAGE
  images.mitmproxy MITMPROXY_IMAGE               images.jdk17 JDK17_IMAGE
  images.jdk21 JDK21_IMAGE                       images.jdk25 JDK25_IMAGE
  images.maven MAVEN_IMAGE                       images.gradle GRADLE_IMAGE
  images.docker_cli DOCKER_CLI_IMAGE             images.dind DIND_IMAGE
  images.golang GOLANG_IMAGE
  pi.package PI_PACKAGE                          pi.apt_packages PI_APT_PACKAGES
  pi.java_default JAVA_DEFAULT                   pi.memory PI_MEMORY
  pi.cpus PI_CPUS                                pi.pids PI_PIDS
  agent_docker.mode AGENT_DOCKER                 agent_docker.sysbox_deb_url SYSBOX_DEB_URL
  agent_docker.address_pool DIND_ADDRESS_POOL    agent_docker.min_api_version DIND_MIN_API_VERSION
  vm.profile VM_PROFILE                          vm.cpus VM_CPUS
  vm.memory VM_MEMORY                            vm.disk VM_DISK
  vm.disk_image VM_DISK_IMAGE
  mac.uid HOST_UID                               mac.gid HOST_GID
)
# yq programs: the settings as key=value lines (lists joined with commas), the bridge's environment
# as NAME=value lines (maps and lists as JSON); every value shell-quoted.
YQ_SETTINGS='del(.bridge, .models) | (.. | select(tag == "!!seq")) |= (map(tostring) | join(","))
  | (.. | select(tag == "!!null")) |= "" | .. | select(tag != "!!map" and (parent | tag) == "!!map")
  | (path | join(".")) + "=" + (tostring | @sh)'
YQ_BRIDGE='.bridge // {} | (.[] | select(tag == "!!map" or tag == "!!seq")) |= to_json(0)
  | (.[] | select(tag == "!!null")) |= "" | to_entries | .[] | .key + "=" + (.value | tostring | @sh)'

load_config() {                             # defaults, then config.yaml on top
  [[ -r "$CONFIG" ]] || die "$CONFIG not found: run <path-to-pi-text>/bin/pibox init"
  have yq || die "yq not found: brew install yq"
  # set -a exports them, so docker compose sees the same values. The agent gets a clean environment.
  set -a
  PROJECTS_DIR="" VAULT_DIR=""
  BRIDGE_PORT=8789 PROXY_PORT=8080 SANDBOX_SUBNET=172.30.0.0/24 MAC_PROXY_PORT="" UPSTREAM_NO_PROXY=""
  EGRESS_ALLOW_PRIVATE="" EGRESS_NO_APPROVAL="" EGRESS_ALLOW_ONLY="" EGRESS_DENY="" EGRESS_PORTS=80,443
  PI_BASH_APPROVAL=risky PI_WEB_PLAIN_HTTP=1 WEB_SEARCH_SEARXNG="" WEB_FETCH_MAX_CHARS=20000
  APT_DEBIAN="" APT_SECURITY=""
  # Taken from your files by pibox setup: npm's and pip's index (also for building the images), the
  # Maven wrapper's repository and login.
  NPM_REGISTRY=https://registry.npmjs.org/ PIP_INDEX_URL=https://pypi.org/simple
  MVNW_REPOURL="" MVNW_USERNAME="" MVNW_PASSWORD=""
  MAVEN_SETTINGS_FILE="" NPMRC_FILE="" DOCKER_DAEMON_FILE="" PIP_CONF_FILE="" DOCKER_CONFIG_FILE=""
  NODE_IMAGE=node:24-bookworm-slim PYTHON_IMAGE=python:3.12-slim MITMPROXY_IMAGE=mitmproxy/mitmproxy:12.3.1
  JDK17_IMAGE=eclipse-temurin:17-jdk JDK21_IMAGE=eclipse-temurin:21-jdk JDK25_IMAGE=eclipse-temurin:25-jdk
  MAVEN_IMAGE=maven:3-eclipse-temurin-21 GRADLE_IMAGE=gradle:jdk21 DOCKER_CLI_IMAGE=docker:29-cli
  DIND_IMAGE=docker:29-dind GOLANG_IMAGE=golang:1.25-bookworm
  PI_PACKAGE=@earendil-works/pi-coding-agent JAVA_DEFAULT=21
  PI_APT_PACKAGES="bash ca-certificates curl git ripgrep jq httpie unzip zip less procps build-essential python3 python3-dev python3-venv python3-pip"
  PI_MEMORY=8g PI_CPUS=4 PI_PIDS=4096
  SYSBOX_DEB_URL=""
  AGENT_DOCKER=sysbox DIND_ADDRESS_POOL=172.31.0.0/16 DIND_MIN_API_VERSION=1.24
  VM_PROFILE=pi VM_CPUS=6 VM_MEMORY=12 VM_DISK=100 VM_DISK_IMAGE=""
  HOST_UID=$(id -u) HOST_GID=$(id -g)

  typeset -ga CFG_ERRORS=(); typeset -gA CFG_LINE=() CFG_TAG=()
  local out line key val sec tag; local -a keys=(${(k)SETTING}) names; local -aU secs=(${(o)keys%%.*})
  out=$(yq '.' "$CONFIG" 2>&1 >/dev/null) || die "$CONFIG is not valid YAML: ${out#Error: }"
  [[ "$(yq 'tag' "$CONFIG")" == '!!map' ]] || die "$CONFIG: expected sections (folders:, bridge:, models:, …), found something else"

  cfg_lines
  # What YAML type each section and setting has
  for line in ${(f)"$(yq '.[] | (line | tostring) + "\t" + tag + "\t" + (key | tostring)' "$CONFIG")"}; do
    sec=${line##*$'\t'} tag=${${line#*$'\t'}%%$'\t'*}
    CFG_TAG[$sec]=$tag
    if [[ "$sec" != (bridge|models) ]] && ! (( ${keys[(I)$sec.*]} )); then
      bad $sec "unknown section; the sections are: bridge, models, ${(j:, :)secs}"
    elif [[ "$sec" == models && "$tag" != '!!seq' ]]; then
      bad $sec "must be a list of models (lines starting with \"- id: …\")"
    elif [[ "$sec" != models && "$tag" != ('!!map'|'!!null') ]]; then
      bad $sec "must be a section: settings as \"name: value\" lines indented below it"
    fi
  done
  for line in ${(f)"$(yq 'del(.bridge, .models) | .. | select((path | length) == 2)
                         | (line | tostring) + "\t" + tag + "\t" + (path | join("."))' "$CONFIG")"}; do
    key=${line##*$'\t'}; CFG_TAG[$key]=${${line#*$'\t'}%%$'\t'*}
  done

  out=$(yq "$YQ_SETTINGS" "$CONFIG" 2>&1) || die "can't read $CONFIG: $out"
  for line in ${(f)out}; do
    key="${line%%=*}"; eval "val=${line#*=}"
    [[ "$key" == *.* ]] || continue                                   # a section, checked above
    if [[ -z "${SETTING[$key]:-}" ]]; then
      sec=${key%%.*}; local two=${(j:.:)${(@)${(s:.:)key}[1,2]}}
      if [[ -n "${SETTING[$two]:-}" ]]; then
        bad $two "must be a single value, not a section"
      elif (( ${keys[(I)$sec.*]} )) && [[ -z "${CFG_ERRORS[(r)*: $two: unknown*]:-}" ]]; then
        names=(${(o)${(M)keys:#$sec.*}#$sec.})
        bad $two "unknown setting in $sec; known: ${(j:, :)names}"
      fi
      continue
    fi
    [[ "${CFG_TAG[$key]}" != '!!map' ]] || { bad $key "must be a value, not a section"; continue }
    if [[ "${CFG_TAG[$key]}" == '!!seq' && "${CHECK[$key]:-}" != (hosts|ports|list) ]]; then
      bad $key "must be a single value, not a list"; continue
    fi
    [[ -n "$val" ]] || continue                                       # empty = the default
    check_value "$key" "${CHECK[$key]:-text}" "$val" || continue
    [[ "$key" == pi.apt_packages ]] && val="${val//,/ }"
    [[ "$val" == true ]] && val=1; [[ "$val" == false ]] && val=0
    typeset -gx "${SETTING[$key]}=$val"
  done

  DOCKER_CONTEXT="${DOCKER_CONTEXT:-colima-$VM_PROFILE}"
  # The proxy on the Mac, as the VM and its containers reach it: Colima's address of the Mac
  # (host.lima.internal), which leads to the Mac's 127.0.0.1.
  UPSTREAM_PROXY="${MAC_PROXY_PORT:+http://$MAC_FROM_VM:$MAC_PROXY_PORT}"
  SANDBOX_PROXY_IP="${SANDBOX_SUBNET%.*}.10"          # fixed address of the proxy on the internal network
  case "$AGENT_DOCKER" in                              # the agent's own Docker engine
    sysbox)     DIND_RUNTIME=sysbox-runc DIND_PRIVILEGED=false PI_DOCKER_HOST=tcp://docker:2375 COMPOSE_PROFILES=docker ;;
    privileged) DIND_RUNTIME=runc DIND_PRIVILEGED=true PI_DOCKER_HOST=tcp://docker:2375 COMPOSE_PROFILES=docker ;;
    off)        DIND_RUNTIME=runc DIND_PRIVILEGED=false PI_DOCKER_HOST="" COMPOSE_PROFILES="" ;;
  esac
  set +a

  # The bridge's environment: not exported, only the bridge container gets it.
  typeset -ga BRIDGE_ENV=()
  out=$(yq "$YQ_BRIDGE" "$CONFIG" 2>/dev/null) || out=""
  for line in ${(f)out}; do
    key=${line%%=*}
    [[ "$key" =~ '^[A-Z_][A-Z0-9_]*$' ]] ||
      { bad bridge.$key "not an environment variable name (A-Z, 0-9, _; e.g. PI_TEXT_URL)"; continue }
    eval "val=${line#*=}"; BRIDGE_ENV+=("$key=$val")
  done
  if [[ "${CFG_TAG[bridge]:-}" != '!!seq' ]]; then
    val=${${BRIDGE_ENV[(r)PI_TEXT_URL=*]:-}#PI_TEXT_URL=}
    if [[ -z "$val" ]]; then bad bridge "PI_TEXT_URL is missing: your router's URL, e.g. https://router.example.com/v1"
    else check_value bridge.PI_TEXT_URL url "$val" || true; fi
    (( ${BRIDGE_ENV[(I)PI_TEXT_KEY=?*]} )) || bad bridge "PI_TEXT_KEY is missing: your router's API key"
  fi

  [[ -n "$PROJECTS_DIR" ]] || bad folders "projects is missing: the absolute path of your projects folder"
  [[ -n "$VAULT_DIR" ]] || bad folders "vault is missing: the absolute path of your Obsidian vault"
  typeset -g PROJECTS="${PROJECTS_DIR:A}" VAULT="${VAULT_DIR:A}"
  check_models
  if (( $#CFG_ERRORS )); then
    print -rl -- "${CFG_ERRORS[@]}" | sort -t: -k2,2n >&2
    die "${#CFG_ERRORS} problem(s) in $CONFIG; nothing was changed"
  fi
}

cfg_lines() {                               # CFG_LINE: the line of each section, setting and model
  setopt local_options extended_glob; local -a match
  # From the text itself: yq's line numbers are off when comments precede a node. Sections are
  # unindented "name:" lines; settings are "name:" lines at the indent of a section's first entry;
  # models are its "- " lines. A setting written in flow style ({a: 1}) gets its section's line.
  local -a lines=("${(@f)$(<"$CONFIG")}"); local i sec="" ind="" l k n=0
  for (( i = 1; i <= $#lines; i++ )); do
    l=$lines[i]
    [[ "$l" =~ '^[[:space:]]*(#|$)' ]] && continue                    # comments, blank lines
    if [[ "$l" =~ '^([^-[:space:]#][^:]*):' ]]; then                  # a section
      sec=${match[1]//[\"\']/} ind="" n=0; CFG_LINE[$sec]=$i; continue
    fi
    [[ -n "$sec" ]] || continue
    if [[ -z "$ind" ]]; then [[ "$l" =~ '^([[:space:]]*)' ]]; ind=$match[1]; fi
    if [[ "$sec" == models ]]; then
      if [[ "$l" =~ '^[[:space:]]{0,'${#ind}'}- *([A-Za-z_]+)?' ]]; then   # "- id: …" starts model n
        CFG_LINE[models.$n]=$i; [[ -z "$match[1]" ]] || CFG_LINE[models.$n.$match[1]]=$i; (( ++n ))
      elif (( n )) && [[ "$l" =~ '^[[:space:]]+([A-Za-z_]+):' ]]; then    # a field of model n-1
        : ${CFG_LINE[models.$((n - 1)).$match[1]]:=$i}
      fi
    elif [[ "${l[1,${#ind}]}" == "$ind" && "$l" =~ '^[[:space:]]*([^[:space:]#:][^:]*):' && "${l[${#ind}+1]}" != [[:space:]] ]]; then
      k=${${match[1]//[\"\']/}%%[[:space:]]#}; CFG_LINE[$sec.$k]=$i
    fi
  done
}

bad() {                                     # bad <setting> <message> [<where>]: one problem of config.yaml
  local w=${3:-$1} l=""                     # the line of <where>, or of the nearest enclosing entry
  while [[ -z "$l" && -n "$w" ]]; do
    l=${CFG_LINE[$w]:-}; [[ "$w" == *.* ]] && w=${w%.*} || w=""
  done
  CFG_ERRORS+=("${CONFIG:t}${l:+:$l}: $1: $2")
}

# What each setting must look like. Settings not listed are free text.
typeset -A CHECK=(
  folders.projects dir                  folders.vault dir
  network.bridge_port port              network.proxy_port port               network.mac_proxy_port port
  network.upstream_no_proxy hosts       network.sandbox_subnet subnet24
  egress.allow_private hosts            egress.no_approval hosts              egress.allow_only hosts
  egress.deny hosts                     egress.ports ports
  extensions.bash_approval 'one of:risky all off'                             extensions.web_plain_http bool
  extensions.searxng url                extensions.fetch_max_chars int
  repository.apt_debian url
  repository.apt_security url           repository.maven_settings file        repository.npmrc file
  repository.docker_daemon file         repository.pip_conf file             repository.docker_config file
  pi.apt_packages list                  pi.java_default 'one of:17 21 25'     pi.memory size
  pi.cpus number                        pi.pids int
  agent_docker.mode 'one of:sysbox privileged off'                            agent_docker.sysbox_deb_url urlorfile
  agent_docker.address_pool cidr        agent_docker.min_api_version apiversion
  vm.cpus int                           vm.memory int                         vm.disk int
  vm.disk_image file                    mac.uid int                           mac.gid int
)

check_value() {                             # check_value <setting> <kind> <value>; may normalise $val
  local key=$1 kind=$2 v=$3 h; local -a items
  case "$kind" in
    port)    [[ "$v" == <1-65535> ]] || { bad $key "must be a port number (1-65535), not '$v'"; return 1 } ;;
    ports)   for h in ${(s:,:)v}; do [[ "$h" == <1-65535> ]] || { bad $key "'$h' is not a port number (1-65535)"; return 1 }; done ;;
    int)     [[ "$v" == <-> && "$v" != 0 ]] || { bad $key "must be a whole number above 0, not '$v'"; return 1 } ;;
    number)  [[ "$v" =~ '^[0-9]+(\.[0-9]+)?$' && "$v" != 0 ]] || { bad $key "must be a number above 0 (e.g. 4 or 2.5), not '$v'"; return 1 } ;;
    bool)    [[ "$v" == (true|false) ]] || { bad $key "must be true or false, not '$v'"; return 1 } ;;
    one\ of:*) items=(${=kind#one of:})
             (( ${items[(Ie)$v]} )) || { bad $key "must be one of ${(j:, :)items}, not '$v'"; return 1 } ;;
    size)    [[ "$v" =~ '^[0-9]+[kmgKMG]?$' ]] || { bad $key "must be a size like 8g or 512m, not '$v'"; return 1 } ;;
    apiversion) [[ "$v" =~ '^[0-9]+\.[0-9]+$' ]] || { bad $key "must be an API version like \"1.24\" (quoted), not '$v'"; return 1 } ;;
    url)     [[ "$v" =~ '^https?://[^/[:space:]]+' ]] || { bad $key "must be a URL starting with http:// or https://, not '$v'"; return 1 } ;;
    cidr|subnet24)
             if [[ ! "$v" =~ '^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]{1,2})$' ]]; then
               bad $key "must be an address range like 172.30.0.0/24, not '$v'"; return 1
             fi
             [[ "$kind" != subnet24 || "${v##*/}" == <16-24> ]] || { bad $key "must be a /16 … /24 range (the proxy gets the address .10 of it), not '$v'"; return 1 } ;;
    hosts)   items=()
             for h in ${(s:,:)v}; do
               h="${${h#\*.}#.}"                 # repo.corp, .corp and *.corp mean the same: see below
               [[ -n "$h" && "$h" != *[*?/:\ ]* ]] ||
                 { bad $key "'$h': write a host or domain (repo.corp, *.corp); no other patterns, ports or URLs"; return 1 }
               items+=("$h")
             done
             val=${(j:,:)items} ;;
    urlorfile) if [[ "$v" != http(|s)://* ]]; then
               [[ "$v" == "~/"* ]] && val="$HOME/${v#\~/}"
               [[ "$val" == /* ]] || { bad $key "must be an http(s):// URL or the path of a file on this Mac (/… or ~/…), not '$v'"; return 1 }
             fi ;;
    dir)     [[ "$v" == /* ]] || { bad $key "must be an absolute path (/Users/…), not '$v'"; return 1 } ;;
    file)    [[ "$v" == "~/"* ]] && val="$HOME/${v#\~/}"
             [[ "$val" == /* ]] || { bad $key "must be an absolute path or ~/…, not '$v'"; return 1 } ;;
  esac
  return 0
}

check_models() {                            # every model needs id, contextWindow, maxTokens
  local line idx etag id cw mt ids="" n=0
  [[ "${CFG_TAG[models]:-}" == '!!seq' || -z "${CFG_TAG[models]:-}" ]] || return 0   # reported above
  [[ -n "${CFG_TAG[models]:-}" ]] || { bad models "is missing: the list of models Pi offers (see the template)"; return 0 }
  for line in ${(f)"$(yq '.models[] | (line | tostring) + "\t" + (path | .[1] | tostring) + "\t" + tag + "\t"
        + ((.id // "") | tostring) + "\t" + ((.id // "") | tag) + "\t" + ((.contextWindow // "") | tostring) + "\t"
        + ((.contextWindow // "") | tag) + "\t" + ((.maxTokens // "") | tostring) + "\t" + ((.maxTokens // "") | tag)' "$CONFIG" 2>/dev/null)"}; do
    local -a f=("${(@ps:\t:)line}")
    (( ++n ))
    idx="models.$f[2]"
    [[ "$f[3]" == '!!map' ]] || { bad $idx "must be a model: id, contextWindow, maxTokens indented below \"- \""; continue }
    id=$f[4] cw=$f[6] mt=$f[8]
    [[ -n "$id" ]] || bad $idx "id is missing: the model name exactly as your router expects it"
    [[ -z "$id" || "$f[5]" == '!!str' ]] || bad $idx "id must be text; quote it: id: \"$id\"" $idx.id
    [[ -z "$id" || "$ids" != *$'\n'"$id"$'\n'* ]] || bad $idx "id $id is listed twice" $idx.id; ids+=$'\n'"$id"$'\n'
    local w=${id:+ ($id)}
    if [[ -z "$cw" ]]; then bad $idx "contextWindow is missing$w: the model's context window in tokens"
    elif [[ "$f[7]" != '!!int' || "$cw" == 0 ]]; then bad $idx "contextWindow$w must be a whole number of tokens, not '$cw'" $idx.contextWindow; fi
    if [[ -z "$mt" ]]; then bad $idx "maxTokens is missing$w: the most tokens of one reply"
    elif [[ "$f[9]" != '!!int' || "$mt" == 0 ]]; then bad $idx "maxTokens$w must be a whole number of tokens, not '$mt'" $idx.maxTokens
    elif [[ "$f[7]" == '!!int' ]] && (( mt >= cw )); then bad $idx "maxTokens$w ($mt) must be smaller than contextWindow ($cw)" $idx.maxTokens; fi
  done
  (( n )) || bad models "is empty: list at least one model"
}

# ---------------------------------------------------------------- generated files
dotenv() {                                  # dotenv <file> NAME=value...: a file docker compose and sh read
  local kv; local -a lines=("# Generated by pibox setup from $CONFIG; edit config.yaml instead.")
  for kv in "${@:2}"; do
    [[ "$kv" != *[\'$'\n']* ]] || die "${kv%%=*}: values with ' or a line break are not supported"
    lines+=("${kv%%=*}='${kv#*=}'")
  done
  mkdir -p "${1:h}"; (umask 077; print -rl -- $lines > "$1")
}

models() {                                  # models <baseUrl> <file>: Pi's model list from config.yaml
  mkdir -p "${2:h}"
  BASE_URL="$1" yq -o=json '{"providers": {"pi-sandbox": {
    "baseUrl": strenv(BASE_URL), "api": "openai-completions", "apiKey": "unused",
    "compat": {"supportsDeveloperRole": false, "supportsStore": false,
               "supportsReasoningEffort": false, "supportsUsageInStreaming": true},
    "models": [.models[] | {"id": .id, "name": .id + " (sandbox)", "reasoning": false, "input": ["text"],
                            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}} * .]}}}' "$CONFIG" > "$2"
}

colima_config() {                           # the VM: only your two folders and ~/.pi-sandbox are shared
  print -r -- "# Generated by pibox setup from $CONFIG; edit config.yaml instead."
  print -r -- "vmType: vz
mountType: virtiofs
runtime: docker
cpu: $VM_CPUS
memory: $VM_MEMORY
disk: $VM_DISK
forwardAgent: false
mounts:
  - location: \"$PROJECTS\"
    writable: true
  - location: \"$VAULT\"
    writable: true
  - location: \"$SB\"
    writable: false"
  [[ -n "$UPSTREAM_PROXY" || "$AGENT_DOCKER" == sysbox ]] || return 0
  print -r -- "docker:"                     # the VM's daemon.json
  [[ -z "$UPSTREAM_PROXY" ]] || print -r -- "  proxies:
    http-proxy: \"$UPSTREAM_PROXY\"
    https-proxy: \"$UPSTREAM_PROXY\"
    no-proxy: \"$UPSTREAM_NO_PROXY\""
  [[ "$AGENT_DOCKER" != sysbox ]] || print -r -- "  runtimes:
    sysbox-runc:
      path: /usr/bin/sysbox-runc"
}

COLIMA_FILE() { print -r -- "${COLIMA_HOME:-$HOME/.colima}/$VM_PROFILE/colima.yaml" }

cmd_setup() {
  local v vmfile old="" ; local -a kv
  [[ -f "$SB/compose.yaml" ]] || die "components missing in $SB: run <path-to-pi-text>/bin/pibox init"
  check_config
  tooling "$SB/generated/c" proxy "$PROXY_PORT" /opt/jdk                      # Maven, Gradle, npm, pip, Docker
  repo_hosts "$SB/generated/c"
  for v in ${(ou)SETTING} NPM_REGISTRY PIP_INDEX_URL MVNW_REPOURL MVNW_USERNAME MVNW_PASSWORD UPSTREAM_PROXY SANDBOX_PROXY_IP DIND_RUNTIME DIND_PRIVILEGED PI_DOCKER_HOST COMPOSE_PROFILES; do
    kv+=("$v=${(P)v}")
  done
  dotenv "$SB/.env" $kv                                         # docker compose
  dotenv "$SB/generated/bridge.env" BRIDGE_PORT="$BRIDGE_PORT" $BRIDGE_ENV   # the bridge container only
  models "http://bridge:$BRIDGE_PORT/v1" "$SB/agent/models.json"
  vmfile=$(COLIMA_FILE); mkdir -p "${vmfile:h}"
  [[ -f "$vmfile" ]] && old=$(<"$vmfile")
  colima_config > "$vmfile"
  print "generated from $CONFIG:
  $SB/.env, $SB/generated/bridge.env, $SB/agent/models.json
  $SB/generated/c/ (settings.xml, toolchains.xml, gradle.properties, init.gradle, npmrc, pip.conf, docker-config.json, daemon.json)
  $vmfile"
  if [[ -n "$old" && "$old" != "$(<"$vmfile")" ]] && vm_running; then
    print "the VM settings changed: pibox down --vm && pibox up applies them"
  fi
  print "next: pibox up"
}

fresh() {                                   # the generated files must be newer than config.yaml
  [[ -f "$SB/.env" && -f "$SB/agent/models.json" ]] || die "nothing generated yet: run pibox setup"
  [[ ! "$CONFIG" -nt "$SB/.env" ]] || die "config.yaml changed since the last setup: run pibox setup"
  local f
  for f in "$MAVEN_SETTINGS_FILE" "$NPMRC_FILE" "$DOCKER_DAEMON_FILE" "$PIP_CONF_FILE" "$DOCKER_CONFIG_FILE"; do
    [[ -z "$f" || ! "$f" -nt "$SB/.env" ]] || die "$f changed since the last setup: run pibox setup"
  done
}

# ---------------------------------------------------------------- helpers
compose_args() {                            # docker compose, with compose.override.yaml if present
  reply=(compose --project-directory "$SB" -f "$SB/compose.yaml")
  [[ -f "$SB/compose.override.yaml" ]] && reply+=(-f "$SB/compose.override.yaml")
  return 0
}
compose() { compose_args; docker $reply "$@" }

vm_running() { colima status -p "$VM_PROFILE" >/dev/null 2>&1 }
running() {                                 # bridge and proxy must be up, or `compose run` would build and start them
  vm_running && [[ -n "$(compose ps -q --status running bridge 2>/dev/null)" ]] || die "the sandbox isn't running: pibox up"
}

here() {                                    # the current folder, if the agent may work in it
  local h="${PWD:A}"
  [[ "$h/" == "$PROJECTS"/* || "$h/" == "$VAULT"/* ]] || die "start it from a folder under $PROJECTS or $VAULT"
  print -r -- "$h"
}

sysbox_installed() {                        # is sysbox installed and running in the VM?
  # Not `docker info`: colima.yaml registers the runtime with Docker before sysbox is installed.
  vm_running 2>/dev/null &&
    colima ssh -p "$VM_PROFILE" -- sh -c 'test -x /usr/bin/sysbox-runc && systemctl is-active -q sysbox' 2>/dev/null
}

sysbox() {                                  # install the sysbox runtime in the VM, once
  sysbox_installed && return 0
  if [[ -n "$SYSBOX_DEB_URL" ]]; then sysbox_deb; else sysbox_build; fi
}

sysbox_build() {                            # sysbox from its sources: clone on the Mac, build in the VM
  local src="$SB/build/sysbox-$SYSBOX_VERSION" out="$SB/generated/sysbox" url=https://github.com/nestybox/sysbox.git
  if [[ "$(cat "$out/VERSION" 2>/dev/null)" != "$SYSBOX_VERSION" ]]; then
    if [[ ! -e "$src/.pibox-complete" ]]; then
      print "fetching the sources of sysbox $SYSBOX_VERSION ($url, with its submodules)"
      rm -rf "$src"; mkdir -p "${src:h}"
      git clone -q --depth 1 --branch "v$SYSBOX_VERSION" --recurse-submodules --shallow-submodules "$url" "$src" 2>/dev/null || {
        rm -rf "$src"                         # a submodule's commit may not be the tip: full history
        git -c advice.detachedHead=false clone -q --branch "v$SYSBOX_VERSION" --recurse-submodules "$url" "$src" ||
          die "can't clone $url: git on this Mac must reach github.com (git config http.proxy, or https_proxy)"
      }
      touch "$src/.pibox-complete"
    fi
    print "building sysbox $SYSBOX_VERSION in the VM (once, a few minutes)"
    rm -rf "$out"
    docker buildx build --progress=plain -f "$SB/sysbox/Dockerfile" \
      --build-arg GOLANG_IMAGE="$GOLANG_IMAGE" --build-arg APT_DEBIAN="$APT_DEBIAN" --build-arg APT_SECURITY="$APT_SECURITY" \
      --build-arg HTTP_PROXY="$UPSTREAM_PROXY" --build-arg HTTPS_PROXY="$UPSTREAM_PROXY" --build-arg NO_PROXY="$UPSTREAM_NO_PROXY" \
      --build-arg http_proxy="$UPSTREAM_PROXY" --build-arg https_proxy="$UPSTREAM_PROXY" --build-arg no_proxy="$UPSTREAM_NO_PROXY" \
      --output "type=local,dest=$out" "$src" 2>&1 | tail -n 15 || die "building sysbox failed (output above)"
    [[ "$(cat "$out/VERSION" 2>/dev/null)" == "$SYSBOX_VERSION" ]] || die "building sysbox failed: no binaries in $out"
  fi
  print "installing sysbox $SYSBOX_VERSION in the VM"
  colima ssh -p "$VM_PROFILE" -- sudo bash "$SB/sysbox/install.sh" "$out" "$UPSTREAM_PROXY" ||
    die "installing sysbox in the VM failed (output above)"
}

sysbox_deb() {                              # sysbox from a package: agent_docker.sysbox_deb_url
  local src="$SYSBOX_DEB_URL"
  if [[ "$src" == /* ]]; then               # a file on the Mac: through ~/.pi-sandbox, which the VM sees
    cp "$src" "$SB/generated/sysbox.deb"; src="$SB/generated/sysbox.deb"
  fi
  print "installing the sysbox runtime in the VM from $SYSBOX_DEB_URL"
  colima ssh -p "$VM_PROFILE" -- env SRC="$src" UPSTREAM_PROXY="$UPSTREAM_PROXY" NO_PROXY="$UPSTREAM_NO_PROXY" bash -s <<'EOF'
set -euo pipefail
cd "$(mktemp -d)"
if [ -f "$SRC" ]; then
  cp "$SRC" sysbox.deb
else
  [ -n "$UPSTREAM_PROXY" ] && export http_proxy="$UPSTREAM_PROXY" https_proxy="$UPSTREAM_PROXY" no_proxy="$NO_PROXY"
  curl -fsSL -o sysbox.deb "$SRC" ||
    { echo "pibox: the VM can't download $SRC: leave agent_docker.sysbox_deb_url empty to build sysbox from its sources" >&2; exit 1; }
fi
docker ps -q | xargs -r docker stop                   # the installer restarts Docker
sudo apt-get install -y ./sysbox.deb
docker info --format '{{json .Runtimes}}' | grep -q sysbox-runc && echo "sysbox-runc is available"
EOF
  rm -f "$SB/generated/sysbox.deb"
}

gq() { local s="$1"; s=${s//\\/\\\\}; s=${s//\'/\\\'}; print -rn -- "'$s'" }   # a Groovy string literal
grepo() {                                   # grepo <name> <url> <user> <password>: one Groovy map
  print -rn -- "    [name: $(gq "$1"), url: $(gq "$2"), user: $(gq "$3"), password: $(gq "$4")],"
}

# Gradle's repositories, sets GRADLE_REPOS and GRADLE_PLUGIN_REPOS (Groovy map lines):
# what Maven itself would use with repository.maven_settings: the repositories of the active
# profiles (activeProfiles, activeByDefault) and Maven Central, each replaced by the mirror whose
# mirrorOf matches it, with the login of the <server> of the same id. Plugins: the
# pluginRepositories, then the same list. Also sets MVNW_*: the Maven wrapper downloads Maven from
# Central's mirror.
gradle_repos() {                            # gradle_repos <the adapted settings.xml>
  typeset -ga GRADLE_REPOS=() GRADLE_PLUGIN_REPOS=()
  local line kind id a b u m pick; local -a mirrors repos plugins fields; local -A user pass seen
  [[ -n "$MAVEN_SETTINGS_FILE" ]] || return 0
  for line in ${(f)"$(yq -p xml -o yaml '.settings as $s
      | ([$s.activeProfiles.activeProfile] | flatten | map(select(. != null))) as $act
      | ([$s.mirrors.mirror] | flatten | map(select(. != null) | "M\t" + (.id // "") + "\t" + (.mirrorOf // "") + "\t" + (.url // "")))
      + ([$s.servers.server] | flatten | map(select(. != null) | "S\t" + (.id // "") + "\t" + (.username // "") + "\t" + (.password // "")))
      + ([$s.profiles.profile] | flatten | map(select(. != null)
          | select((.id as $i | $act | any_c(. == $i)) or (.activation.activeByDefault // "") == "true")
          | ([.repositories.repository] | flatten | map(select(. != null) | "R\t" + (.id // "") + "\t" + (.url // "")))
          + ([.pluginRepositories.pluginRepository] | flatten | map(select(. != null) | "P\t" + (.id // "") + "\t" + (.url // "")))) | flatten)
      | .[]' "$1")"}; do
    fields=("${(@ps:\t:)line}"); kind=$fields[1] id=${fields[2]:-} a=${fields[3]:-} b=${fields[4]:-}
    case $kind in
      M) mirrors+=("$id"$'\t'"$a"$'\t'"$b") ;;
      S) user[$id]=$a pass[$id]=$b ;;
      R) repos+=("$id"$'\t'"$a") ;;
      P) plugins+=("$id"$'\t'"$a") ;;
    esac
  done
  repos+=("central"$'\t'"http://repo.maven.apache.org/maven2")      # Maven's own default, last
  resolve() {                               # resolve <id> <url>: REPLY = "id<TAB>url" after mirrors
    local rid=$1 rurl=$2 mm mid mof murl p hit
    REPLY="$rid"$'\t'"$rurl"
    for mm in $mirrors; do                  # an exact id wins over patterns
      mid=${mm%%$'\t'*} mof=${${mm#*$'\t'}%%$'\t'*} murl=${mm##*$'\t'}
      [[ ",${mof// /}," == *",$rid,"* ]] && { REPLY="$mid"$'\t'"$murl"; return }
    done
    for mm in $mirrors; do
      mid=${mm%%$'\t'*} mof=${${mm#*$'\t'}%%$'\t'*} murl=${mm##*$'\t'} hit=0
      for p in ${(s:,:)mof// /}; do
        case $p in
          "!$rid") hit=0; break ;;
          '*') hit=1 ;;
          external:\*|external:http:\*) [[ "$rurl" == (file:*|*://localhost*|*://127.0.0.1*) ]] || hit=1 ;;
        esac
      done
      (( hit )) && { REPLY="$mid"$'\t'"$murl"; return }
    done
  }
  add() {                                   # add <array> <id> <url>, unless the URL is listed already
    resolve "$2" "$3"; id=${REPLY%%$'\t'*} u=${REPLY#*$'\t'}
    if [[ "$id" == central && "$u" == http://repo.maven.apache.org/* ]]; then
      warn "Gradle: Maven Central has no mirror in $MAVEN_SETTINGS_FILE, so builds can't reach it (only plain HTTP passes the filter)"
      return 0
    fi
    local k="$1 $u"
    [[ -z "${seen[$k]:-}" ]] || return 0; seen[$k]=1
    eval "$1+=(\"\$(grepo \"\$id\" \"\$u\" \"\${user[\$id]:-}\" \"\${pass[\$id]:-}\")\")"
  }
  for m in $repos; do add GRADLE_REPOS "${m%%$'\t'*}" "${m#*$'\t'}"; done
  for m in $plugins $repos; do add GRADLE_PLUGIN_REPOS "${m%%$'\t'*}" "${m#*$'\t'}"; done 2>/dev/null
  resolve central http://repo.maven.apache.org/maven2
  if [[ "${REPLY#*$'\t'}" != http://repo.maven.apache.org/* ]]; then
    id=${REPLY%%$'\t'*}; MVNW_REPOURL=${REPLY#*$'\t'} MVNW_USERNAME=${user[$id]:-} MVNW_PASSWORD=${pass[$id]:-}
  fi
  print "Gradle uses the repositories of $MAVEN_SETTINGS_FILE: ${#GRADLE_REPOS} for dependencies, ${#GRADLE_PLUGIN_REPOS} for plugins"
}


# ---- your own configuration files (repository.maven_settings, .npmrc, .docker_daemon)
# They are copied, not mounted: the VM doesn't see your home folder. What would break inside the
# sandbox is changed in the copy: every request must go through the filtering proxy as plain HTTP.

own_maven_settings() {                      # own_maven_settings <yours> <copy> <proxy host> <port> <non-proxy hosts>
  local n
  grep -qE '<password>[[:space:]]*\{' "$1" &&
    warn "$1 has encrypted passwords: Maven can't decrypt them in the sandbox (no settings-security.xml); give it a file with plain READ-ONLY tokens"
  grep -q '\${env\.' "$1" && warn "$1 uses \${env.…}: your Mac's environment variables don't exist in the sandbox"
  perl -0ne 'exit(/<url>\s*https:\/\//s ? 0 : 1)' "$1" && n=1 || n=0
  # Comments out (they may hold <proxies> examples), your proxies and local repository path out
  # (paths of the Mac), every https:// repository URL as http://, the filtering proxy in.
  (umask 077
   PROXIES="  <proxies>
    <proxy><id>pi-sandbox</id><active>true</active><protocol>http</protocol><host>$3</host><port>$4</port><nonProxyHosts>$5</nonProxyHosts></proxy>
  </proxies>" SRC="$1" perl -0pe '
     s/<!--.*?-->//gs;
     s/\s*<proxies\s*\/>//s; s/\s*<proxies>.*?<\/proxies>//s;
     s/\s*<localRepository>.*?<\/localRepository>//s; s/\s*<localRepository\s*\/>//s;
     s/\s*<offline>.*?<\/offline>//s;
     s/(<url>\s*)https:\/\//${1}http:\/\//g;
     s/\A(<\?xml[^>]*\?>\s*)?/($1 \/\/ "") . "<!-- Copied by pibox setup from $ENV{SRC}, adapted to the sandbox; edit the original. -->\n"/e;
     s/\s*<\/settings>\s*\z/\n$ENV{PROXIES}\n<\/settings>\n/s or die "no </settings> at the end\n";
   ' "$1" > "$2") || die "can't adapt $1"
  yq -p xml '.' "$2" >/dev/null 2>&1 || die "$1: the adapted copy $2 isn't valid XML"
  (( n )) && print "$1: https:// repository URLs are http:// in the sandbox's copy (only plain HTTP passes the filter)"
  return 0
}

own_npmrc() {                               # own_npmrc <yours> <copy> <proxy host> <port> <non-proxy hosts>
  local reg
  grep -q '\${' "$1" && warn "$1 uses \${…}: your Mac's environment variables don't exist in the sandbox"
  (umask 077
   { print -r -- "# Copied by pibox setup from $1, adapted to the sandbox; edit the original."
     # Your proxy settings and Mac paths out, https:// registries as http://, the filtering proxy in.
     grep -vE '^[[:space:]]*(proxy|https-proxy|http-proxy|noproxy|no-proxy|cafile|ca|strict-ssl|prefix|cache|globalconfig|userconfig|init-module)[[:space:]]*=' "$1" |
       sed -E 's#^([[:space:]]*(@[^:=[:space:]]+:)?registry[[:space:]]*=[[:space:]]*)https://#\1http://#'
     print -r -- "proxy=http://$3:$4/
https-proxy=http://$3:$4/
noproxy=${5//|/,}
audit=false
fund=false
update-notifier=false"
   } > "$2") || die "can't adapt $1"
  # npm's own key: //host/path/:_authToken: the registry URL without scheme, https or http alike.
  reg=$(sed -nE 's#^[[:space:]]*registry[[:space:]]*=[[:space:]]*##p' "$2" | tail -1)
  [[ -z "$reg" ]] || NPM_REGISTRY="$reg"      # also used for building the image and by corepack
  grep -qE '^[[:space:]]*(@[^:=[:space:]]+:)?registry[[:space:]]*=[[:space:]]*https://' "$1" &&
    print "$1: https:// registries are http:// in the sandbox's copy (only plain HTTP passes the filter)"
  return 0
}

own_pip_conf() {                            # own_pip_conf <yours> <copy> <proxy host> <port>
  # E.g. the pip.conf of Artifactory's "Set Me Up". Your proxy, certificate and Mac paths out,
  # https:// index URLs as http://, every index host trusted (pip refuses plain http otherwise),
  # the filtering proxy in. Keys pibox sets are removed everywhere, or pip would see them twice.
  grep -q '\${\|%(' "$1" && warn "$1 uses \${…} or %(…)s: your Mac's environment variables don't exist in the sandbox"
  local -aU hosts; local u h
  (umask 077
   awk -v head="# Copied by pibox setup from $1, adapted to the sandbox; edit the original." \
       -v ours="proxy = http://$3:$4" '
     BEGIN { print head }
     /^[ \t]*[A-Za-z_-]+[ \t]*[=:]/ {
       key = $0; sub(/^[ \t]*/, "", key); sub(/[ \t]*[=:].*/, "", key); key = tolower(key); gsub(/_/, "-", key)
       skip = key ~ /^(proxy|trusted-host|cert|client-cert|cache-dir|target|prefix|root|src|build|log|user|require-virtualenv)$/
       if (skip) next
     }
     /^[ \t]+[^ \t]/ && skip { next }                       # a continuation line of a removed key
     /^[ \t]*\[/ { skip = 0 }
     { gsub(/https:\/\//, "http://"); print }
     /^[ \t]*\[global\][ \t]*$/ && !done { print ours; done = 1 }
     END { if (!done) { print "[global]"; print ours } }
   ' "$1" > "$2") || die "can't adapt $1"
  for u in ${(f)"$(grep -v '^proxy = ' "$2" | grep -oE 'https?://[^[:space:]]+')"}; do   # the index URLs
    h=${${${u#*://}%%/*}##*@}; hosts+=("${h%%:*}")
  done
  u=$(sed -nE 's#^[[:space:]]*index[-_]url[[:space:]]*[=:][[:space:]]*##p' "$2" | head -1)
  [[ -z "$u" ]] || PIP_INDEX_URL=$u                     # also for building the bridge's image
  H="trusted-host = ${(j: :)hosts}" perl -i -pe 's/^(proxy = .*)$/$1\n$ENV{H}/ if /^proxy = / && !$d++' "$2"
  grep -q 'https://' "$1" && print "$1: https:// index URLs are http:// in the sandbox's copy (only plain HTTP passes the filter)"
  return 0
}

own_docker_config() {                       # own_docker_config <yours or ""> <copy>
  # The docker CLI's config.json, e.g. ~/.docker/config.json: only the logins written in it
  # ("auths" entries with "auth" or username/password) are kept. credsStore/credHelpers point to
  # your Mac's keychain, which the sandbox doesn't have; everything else is about your Mac too.
  # Sets DOCKER_LOGIN_REGS: the registries (host[:port]) with a login, except Docker Hub.
  typeset -ga DOCKER_LOGIN_REGS=()
  local src=${1:-} reg n
  if [[ -n "$src" ]]; then
    yq -p json '.' "$src" >/dev/null 2>&1 || die "$src: not valid JSON"
    n=$(yq -p json -o yaml '[(.auths // {}) | to_entries | .[] | select((.value.auth // .value.username // "") == "")] | length' "$src")
    (( n == 0 )) || warn "$src: $n registr(y/ies) without a login in the file (kept in the keychain via credsStore/credHelpers): not available in the sandbox; use docker login --password-stdin with a config that has no credsStore, or write the auth into the file"
    for reg in ${(f)"$(yq -p json -o yaml '(.auths // {}) | to_entries | .[] | select((.value.auth // .value.username // "") != "") | .key' "$src")"}; do
      reg=${${reg#*://}%%/*}
      [[ "$reg" == (index.docker.io|docker.io|registry-1.docker.io|) ]] || DOCKER_LOGIN_REGS+=("$reg")
    done
  fi
  (umask 077; SRC="${src:-/dev/null}" P="http://$SANDBOX_PROXY_IP:$PROXY_PORT" yq -n -o json '
    (load(strenv(SRC)) // {}) as $c
    | {"auths": (($c.auths // {}) | with_entries(select((.value.auth // .value.username // "") != "")
                                    | .value = (.value | with_entries(select(.key == "auth" or .key == "username" or .key == "password" or .key == "identitytoken"))))),
       "proxies": {"default": {"httpProxy": strenv(P), "httpsProxy": strenv(P), "noProxy": "localhost,127.0.0.1"}}}
  ' > "$2") || die "can't adapt ${src:-the Docker CLI config}"
  (( $#DOCKER_LOGIN_REGS )) && print "${src}: logins for ${(j:, :)DOCKER_LOGIN_REGS}; the agent's engine reaches them over plain HTTP"
  return 0
}

own_daemon() {                              # own_daemon <yours> <copy> <proxy port>
  # Settings that clash with how the engine runs here out; mirrors as plain HTTP (so also insecure
  # registries); the filtering proxy, the address pool and the snapshotter of the sandbox in.
  # Registries you have a login for (docker_config) are plain HTTP too.
  (umask 077; P="http://proxy:$3" POOL="$DIND_ADDRESS_POOL" REGS="${(j:,:)DOCKER_LOGIN_REGS}" yq -p json -o json '
    del(.hosts, .tls, .tlsverify, .tlscacert, .tlscert, .tlskey, .["data-root"], .["exec-root"], .pidfile)
    | .["registry-mirrors"] = ((.["registry-mirrors"] // []) | map(sub("^https://"; "http://")))
    | .["insecure-registries"] = ((.["insecure-registries"] // [])
        + (.["registry-mirrors"] | map(sub("^https?://"; "") | sub("/.*$"; "")))
        + (strenv(REGS) | split(",") | map(select(. != ""))) | unique)
    | .proxies = {"http-proxy": strenv(P), "https-proxy": strenv(P), "no-proxy": "localhost,127.0.0.1"}
    | .["default-address-pools"] = (.["default-address-pools"] // [{"base": strenv(POOL), "size": 24}])
    | .features["containerd-snapshotter"] |= (. // false)
  ' "$1" > "$2") || die "$1: not valid JSON"
}

repo_hosts() {                              # repo_hosts <dir>: the repositories' hosts into the egress lists
  # Every repository the generated files point to may be fetched from without asking you and even
  # if it's in your network; its port is allowed. Public default registries are not added.
  local dir=$1 u h; local -a urls; local -aU hosts ports
  urls=(${(f)"$(sed -nE 's#.*<url>[[:space:]]*([^<[:space:]]*)[[:space:]]*</url>.*#\1#p' "$dir/settings.xml")"}
        ${(f)"$(sed -nE 's#^[[:space:]]*(@[^:=[:space:]]+:)?registry[[:space:]]*=[[:space:]]*##p' "$dir/npmrc")"}
        ${(f)"$(grep -v '^proxy[[:space:]]*=' "$dir/pip.conf" | grep -oE 'https?://[^[:space:]]+')"}
        ${(f)"$(yq -p json -o yaml '(.["registry-mirrors"] // [])[], (.["insecure-registries"] // [])[]' "$dir/daemon.json")"})
  for u in $urls; do
    [[ -n "$u" && "$u" != *'$'* ]] || continue
    h=${${${u#*://}%%/*}##*@}
    [[ "${h%%:*}" == (|registry.npmjs.org|pypi.org|localhost|127.0.0.1|proxy|bridge|docker|\[*) ]] && continue
    hosts+=("${h%%:*}")
    [[ "$h" == *:<-> ]] && ports+=("${h##*:}")
  done
  (( $#hosts )) || return 0
  local -aU l                               # -U: no duplicates
  l=(${(s:,:)EGRESS_NO_APPROVAL} $hosts);   EGRESS_NO_APPROVAL=${(j:,:)l}
  l=(${(s:,:)EGRESS_ALLOW_PRIVATE} $hosts); EGRESS_ALLOW_PRIVATE=${(j:,:)l}
  l=(${(s:,:)EGRESS_PORTS} $ports);         EGRESS_PORTS=${(j:,:)l}
  print "repositories, reachable without asking you (egress): ${(j:, :)hosts}${ports:+; ports ${(j:, :)ports}}"
}

tooling() {                                 # tooling <dir> <proxy host> <proxy port> <jdk dir or "">
  local dir=$1 ph=$2 pp=$3 jdks=$4 nonproxy="localhost|127.0.0.1|bridge|docker" v
  mkdir -p "$dir"; chmod 700 "$dir"
  # Each tool: your own file (repository section) adapted to the sandbox, or, without one, only the
  # filtering proxy (the public servers then can't be reached: they answer HTTPS only).

  # Maven
  if [[ -n "$MAVEN_SETTINGS_FILE" ]]; then
    own_maven_settings "$MAVEN_SETTINGS_FILE" "$dir/settings.xml" "$ph" "$pp" "$nonproxy"
  else {
    print -r -- "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!-- Generated by pibox setup: no repository.maven_settings in config.yaml. -->
<settings xmlns=\"http://maven.apache.org/SETTINGS/1.2.0\">
  <proxies>
    <proxy><id>pi-sandbox</id><active>true</active><protocol>http</protocol><host>$ph</host><port>$pp</port><nonProxyHosts>$nonproxy</nonProxyHosts></proxy>
  </proxies>
</settings>"
  } > "$dir/settings.xml"
  fi

  # Maven toolchains and Gradle toolchain paths: the JDKs baked into the image.
  {
    print -r -- "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<toolchains>"
    if [[ -n "$jdks" ]]; then
      for v in 17 21 25; do
        print -r -- "  <toolchain><type>jdk</type><provides><version>$v</version></provides><configuration><jdkHome>$jdks/$v</jdkHome></configuration></toolchain>"
      done
    fi
    print -r -- "</toolchains>"
  } > "$dir/toolchains.xml"
  {
    print -r -- "# Generated by pibox setup from config.yaml
systemProp.http.proxyHost=$ph
systemProp.http.proxyPort=$pp
systemProp.http.nonProxyHosts=$nonproxy
systemProp.https.proxyHost=$ph
systemProp.https.proxyPort=$pp
systemProp.https.nonProxyHosts=$nonproxy
org.gradle.java.installations.auto-download=false"
    [[ -n "$jdks" ]] && print -r -- "org.gradle.java.installations.paths=$jdks/17,$jdks/21,$jdks/25"
  } > "$dir/gradle.properties"

  # Gradle: replace every remote repository (projects, buildscripts, plugins) by the repositories
  # of your settings.xml (repository.maven_settings).
  gradle_repos "$dir/settings.xml"
  {
    print -r -- "// Generated by pibox setup from config.yaml${MAVEN_SETTINGS_FILE:+ and $MAVEN_SETTINGS_FILE}:
// every remote repository of a build is replaced by these.
def REPOS = ["
    print -rl -- $GRADLE_REPOS
    print -r -- "]
def PLUGIN_REPOS = ["
    print -rl -- $GRADLE_PLUGIN_REPOS
    print -r -- ']
if (!REPOS) return

def addRepos = { RepositoryHandler repos, List list ->
    list.each { m ->
        repos.maven { r ->
            r.name = "pi-sandbox-${m.name}"
            r.url = m.url
            r.allowInsecureProtocol = true
            if (m.user) { r.credentials { username = m.user; password = m.password } }
        }
    }
}
def dropRemote = { RepositoryHandler repos ->
    def found = [false]
    repos.all { r ->
        if (!r.name.startsWith("pi-sandbox-") && (r instanceof MavenArtifactRepository || r instanceof IvyArtifactRepository)
                && ["http", "https"].contains(r.url?.scheme)) {
            found[0] = true
            repos.remove(r)
        }
    }
    return { -> found[0] }
}

beforeSettings { settings ->
    dropRemote(settings.pluginManagement.repositories)
    addRepos(settings.pluginManagement.repositories, PLUGIN_REPOS)
    dropRemote(settings.dependencyResolutionManagement.repositories)
    addRepos(settings.dependencyResolutionManagement.repositories, REPOS)
}
allprojects { p ->
    dropRemote(p.buildscript.repositories)
    addRepos(p.buildscript.repositories, REPOS)
    def used = dropRemote(p.repositories)
    p.afterEvaluate { if (used()) addRepos(p.repositories, REPOS) }
}'
  } > "$dir/init.gradle"

  # npm, pip
  if [[ -n "$NPMRC_FILE" ]]; then
    own_npmrc "$NPMRC_FILE" "$dir/npmrc" "$ph" "$pp" "$nonproxy"
  else {
    print -r -- "# Generated by pibox setup: no repository.npmrc in config.yaml
registry=$NPM_REGISTRY
proxy=http://$ph:$pp/
https-proxy=http://$ph:$pp/
noproxy=${nonproxy//|/,}
audit=false
fund=false
update-notifier=false"
  } > "$dir/npmrc"
  fi
  if [[ -n "$PIP_CONF_FILE" ]]; then
    own_pip_conf "$PIP_CONF_FILE" "$dir/pip.conf" "$ph" "$pp"
  else
    print -r -- "# Generated by pibox setup: no repository.pip_conf in config.yaml
[global]
proxy = http://$ph:$pp" > "$dir/pip.conf"
  fi

  # Docker CLI: your logins (docker_config), and the proxy for the containers and builds it starts.
  own_docker_config "${DOCKER_CONFIG_FILE:-}" "$dir/docker-config.json"

  # The agent's Docker engine: your daemon.json (or an empty one), adapted.
  local empty="$dir/.daemon-empty.json"
  [[ -n "$DOCKER_DAEMON_FILE" ]] || print '{}' > "$empty"
  own_daemon "${DOCKER_DAEMON_FILE:-$empty}" "$dir/daemon.json" "$pp"
  rm -f "$empty"
}


# ---------------------------------------------------------------- commands
cmd="${1:-help}"; (( $# )) && shift
case "$cmd" in
  help|-h|--help) usage; exit 0 ;;
  init)           cmd_init; exit 0 ;;
  check)          cmd_check; exit $? ;;
esac

load_config
case "$cmd" in

setup)                                      # every configuration, from config.yaml
  cmd_setup
  ;;

config)                                     # the settings in effect (secrets masked)
  local k v kv
  for k in ${(ok)SETTING}; do
    v="${(P)SETTING[$k]}"
    print -r -- "$k: $v"
  done
  for kv in $BRIDGE_ENV; do
    k="${kv%%=*}" v="${kv#*=}"
    [[ "$k" == *(KEY|TOKEN|SECRET|PASSWORD)* ]] && v="${v:+set (${#v} chars)}"
    print -r -- "bridge.$k: $v"
  done
  yq '.models[] | "model: " + .id + "  contextWindow " + (.contextWindow | tostring)
      + ", maxTokens " + (.maxTokens | tostring) + ", reasoning " + (.reasoning // false | tostring)' "$CONFIG"
  print -r -- "proxy on the Mac, as the VM reaches it: ${UPSTREAM_PROXY:-none (direct)}"
  print -r -- "docker context: $DOCKER_CONTEXT, VM config: $(COLIMA_FILE)"
  ;;

up)                                         # VM, images, bridge, proxy, the agent's Docker engine
  fresh
  if ! vm_running; then
    print "starting the Colima VM $VM_PROFILE"
    colima start "$VM_PROFILE" ${VM_DISK_IMAGE:+--disk-image "$VM_DISK_IMAGE"}
  fi
  colima ssh -p "$VM_PROFILE" -- sh -c 'mount | grep -E "virtiofs|9p|sshfs"' | sed 's/^/shared with the VM: /'
  [[ "$AGENT_DOCKER" != sysbox ]] || sysbox
  compose build
  compose up -d --remove-orphans bridge proxy ${PI_DOCKER_HOST:+docker}
  for i in {1..30}; do                      # wait until the bridge accepts connections
    compose exec -T bridge python3 -c "import socket; socket.create_connection(('127.0.0.1', $BRIDGE_PORT), 1)" \
      2>/dev/null && { print "bridge is up on port $BRIDGE_PORT; next: pibox approve (one terminal), pibox run (another)"; exit 0 }
    sleep 1
  done
  die "the bridge didn't start: pibox status, docker --context $DOCKER_CONTEXT compose --project-directory $SB logs bridge"
  ;;

run)                                        # Pi in a fresh container, in the current folder
  fresh; running
  local h; h=$(here)
  compose_args; exec docker $reply run --rm -w "$h" pi "$@"
  ;;

shell)                                      # bash in the agent's container, without Pi
  fresh; running
  local h; h=$(here)
  compose_args; exec docker $reply run --rm -w "$h" --entrypoint bash pi "$@"
  ;;

approve)                                    # the approval console (detach: Ctrl-P Ctrl-Q)
  local id; id=$(compose ps -q proxy)
  [[ -n "$id" ]] || die "the proxy isn't running: pibox up"
  exec docker attach "$id"
  ;;

log)                                        # follow the web journal
  compose_args; exec docker $reply exec -T proxy tail -n 50 -F /home/mitmproxy/.mitmproxy/egress.log
  ;;

status)                                     # the VM and the containers
  colima status -p "$VM_PROFILE" 2>&1 || true
  vm_running && compose ps
  ;;

down)                                       # stop the containers; --vm: the VM too
  vm_running && compose down
  [[ "${1:-}" != --vm ]] || colima stop "$VM_PROFILE"
  ;;

verify)                                     # try everything the agent must not be able to do
  fresh; running
  compose run --rm -T --entrypoint bash pi -c "
    B=$BRIDGE_PORT; V=${(q)VAULT}; cd ${(q)PROJECTS}; set -x
    ls \"\$PWD\" | head -3                                       # your projects
    ls ~/.pi-sandbox /Users/*/.ssh 2>&1 | head -2                # no such directory
    curl -sS --noproxy '*' -m 5 http://example.com               # fails: no route
    curl -sS --noproxy '*' -m 5 http://$MAC_FROM_VM:\$B           # fails: the Mac is unreachable
    ${MAC_PROXY_PORT:+curl -sS --noproxy '*' -m 5 -x http://$MAC_FROM_VM:$MAC_PROXY_PORT http://example.com  # fails: the Mac's proxy too}
    curl -sS -m 5 https://example.com                            # 403: encrypted tunnels refused
    curl -sS -X POST -d x http://example.com                     # 405 from the egress policy
    curl -sS -m 5 http://192.168.1.1/                            # 403: private address
    curl -sS http://bridge:\$B/v1/models | head -c 100; echo     # the bridge answers
    touch \"\$PWD/.pi-ok\" && rm \"\$PWD/.pi-ok\" && echo projects-writable
    touch \"\$V/.pi-ok\" && rm \"\$V/.pi-ok\" && echo vault-writable
    touch \"\$V/.obsidian/x\"                                    # read-only file system
    touch /home/pi/.pi/agent/extensions/x                        # read-only file system
    java -version 2>&1 | head -1; jdk 17 java -version 2>&1 | head -1; mvn -v | head -1; gradle -v | grep ^Gradle
    node -v; python3 -V; docker compose version
    if [ -n \"\$DOCKER_HOST\" ]; then docker info --format 'agent docker: {{.ServerVersion}}'; fi
    curl -sS -m 30 http://example.com | head -c 200; echo        # waits for your approval (pibox approve)
  " </dev/null
  ;;

review)                                     # changes that would make YOUR tools run code later
  local risky='^(core\.(fsmonitor|hookspath|sshcommand|pager|editor|askpass|gitproxy|worktree)|alias\.|filter\.|diff\..*\.(textconv|command)|merge\..*\.driver|credential\.|include\.|includeif\.|uploadpack\.|remote\..*\.(uploadpack|receivepack|vcs))'
  local found=0 gitdir keys h changed
  local -a hooks
  while IFS= read -r gitdir; do
    hooks=("${(@f)$(find "$gitdir/hooks" -type f ! -name '*.sample' 2>/dev/null)}")
    keys=$(git config --file "$gitdir/config" --get-regexp "$risky" 2>/dev/null || true)
    if [[ -n "${hooks[*]}" || -n "$keys" ]]; then
      found=1
      print "⚠️  ${gitdir:h}"
      for h in $hooks; do [[ -n "$h" ]] && print "    hook: ${h#$gitdir/}"; done
      [[ -n "$keys" ]] && print -r -- "$keys" | sed 's/^/    config: /'
      print "    → inspect before running any git command in it (git itself would run these)"
    fi
  done < <(find "$PROJECTS" "$VAULT" -maxdepth 4 -name node_modules -prune -o -name .git -type d -print 2>/dev/null)
  changed=$(find "$VAULT/.obsidian" -type f -mtime -1 2>/dev/null || true)
  if [[ -n "$changed" ]]; then
    found=1
    print "⚠️  Obsidian settings changed in the last 24 h (plugins run with your rights):"
    print -r -- "$changed" | sed 's/^/    /'
  fi
  (( found )) || print "pibox review: nothing suspicious (hooks, git config, .obsidian)"
  exit $found
  ;;

*)
  usage; exit 1
  ;;
esac
